generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////


enum Department {
  MCA
  MTECH
  IMTECH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcadLevel{
  TENTH
  TWELFTH
  DIPLOMA
  GRADUATION
  POSTGRADUATION
}

enum Stream {
  CSE
  AI
  IT
}

enum Role {
  PLACEMENT_OFFICER
  PLACEMENT_COORDINATOR
  STREAM_COORDINATOR
  STUDENT
}

enum ApplicationStatus {
  APPLIED
  REJECTED
  IGNORED
  SHORTLISTED
  SELECTED
}

//////////////////////////////////////
// USER MODEL (Authentication Only)
//////////////////////////////////////

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String

  role      Role     @default(STUDENT)

  placed    Boolean  @default(false)
  blocked   Boolean  @default(false)

  coordinatorDepartment Department?
  coordinatorStream     Stream?

  createdAt DateTime @default(now())

  //////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////

  studentProfile    StudentProfile?

  applications      Application[]
  createdCompanies Company[]

  studentPlacements PlacementRecord[] @relation("StudentPlacement")

  createdPlacements PlacementRecord[] @relation("CoordinatorCreatedPlacement")

  remarksAdded      PlacementRemark[] @relation("RemarkAddedBy")
}

//////////////////////////////////////
// STUDENT PROFILE (Academic Details)
//////////////////////////////////////

model StudentProfile {
  id           Int    @id @default(autoincrement())

  user         User   @relation(fields: [userId], references: [id])
  userId       Int    @unique
  alternateEmail String?
  linkedInUrl   String?
  githubUrl     String?
  gender        Gender @default(MALE)  //sorry for the default, can be changed during registration
  dob           DateTime?
  category      String?
  permanentAddress String @default("")
  currentAddress   String @default("")
  preferredJobLocation String?
  carreerType       String? // research, industry, undecided
  batchYear    Int @default(0)

  department   Department
  stream       Stream?
  AcadamicDetails AcademicRecord[] 

  rollNo       String @unique
  phone        String
  resumeUrl    String?
  createdAt    DateTime @default(now())
}

model AcademicRecord {
  id           Int    @id @default(autoincrement())
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  studentProfileId Int
  level        AcadLevel @default(GRADUATION)
  institution_school_name   String @default("")
  board String?
  university String?
  yearOfPassing Int @default(0)
  percentage_cgpa Float @default(0.0)
}

//////////////////////////////////////
// COMPANY MODEL
//////////////////////////////////////

model Company {
  id             Int      @id @default(autoincrement())
  name           String
  description    String
  package        Float
  department     Department
  streamsAllowed Stream[]
  jobTitle       String @default("")
  address       String?
  state           String?
  country         String?
  website         String?
  type_of_organization String?
  skillsRequired   String[] @default([])
  jobLocation      String?
  remarks           String?
  no_vacancies        Int?
  nature_of_business     String?
  deadline       DateTime
  jd_file_path String?
  //////////////////////////////////////
  // AUDIT FIELDS
  //////////////////////////////////////

  createdBy      User     @relation(fields: [createdById], references: [id])
  createdById    Int

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  //////////////////////////////////////

  applications     Application[]
  placementRecords PlacementRecord[]
}

//////////////////////////////////////
// APPLICATION MODEL
//////////////////////////////////////

model Application {
  id        Int      @id @default(autoincrement())
  status    ApplicationStatus @default(APPLIED)

  student   User   @relation(fields: [studentId], references: [id])
  studentId Int

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int

  @@unique([studentId, companyId])
}

//////////////////////////////////////
// PLACEMENT RECORD
//////////////////////////////////////

model PlacementRecord {
  id          Int      @id @default(autoincrement())

  student     User     @relation("StudentPlacement", fields: [studentId], references: [id])
  studentId   Int

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   Int

  remarks     String?
  issues      String?
  joiningDate DateTime?
  packageFinal Float?

  createdBy   User     @relation("CoordinatorCreatedPlacement", fields: [createdById], references: [id])
  createdById Int

  createdAt   DateTime @default(now())

  remarksHistory PlacementRemark[]

  @@unique([studentId, companyId])
}

//////////////////////////////////////
// PLACEMENT REMARK
//////////////////////////////////////

model PlacementRemark {
  id           Int @id @default(autoincrement())

  placement    PlacementRecord @relation(fields: [placementId], references: [id])
  placementId  Int

  comment      String

  addedBy      User @relation("RemarkAddedBy", fields: [addedById], references: [id])
  addedById    Int

  createdAt    DateTime @default(now())
}